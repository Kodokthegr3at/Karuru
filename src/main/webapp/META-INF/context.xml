<?xml version="1.0" encoding="UTF-8"?>
<!-- UTF-8 is set by util.EncodingFilter, not here: Tomcat ignores this file when the context is defined elsewhere. -->
<Context>
    <!-- SameSite=Lax session cookie: browsers won't send it on cross-site POSTs (CSRF defense, see util.CsrfFilter) -->
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax"/>
</Context>
